{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm test && next build",
    "start": "next start",
    "desktop:dev": "concurrently -k \"cross-env NEXT_DIST_DIR=.next-desktop next dev --port 3210\" \"wait-on tcp:3210 && electron desktop/main.cjs\"",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.caosao.commit.mural",
    "productName": "Mural do Caos ao Commit",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "desktop/**/*",
      ".next/**/*",
      "public/**/*",
      "src/**/*",
      "!src/**/*.test.*",
      "!src/**/test/**",
      "next.config.ts",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
